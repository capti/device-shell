# Скопируйте в backend/.env и поправьте под окружение.

APP_ENV=development
APP_BASE_URL=http://localhost:8000

# По умолчанию используется data/qa.db рядом с каталогом backend.
# DATABASE_URL=sqlite:///D:/repos/qa-test-staff/data/qa.db
# DATA_DIR=D:/repos/qa-test-staff/data

SESSION_TTL_DAYS=7
COOKIE_SECURE=false

# Ограничение попыток входа
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_LOCKOUT_MINUTES=15
